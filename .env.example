# Copy this file to `.env` at the repository root, then set local values.
# `.env` is ignored by Git. Never commit a real secret.

# Google AI Studio API key (server-side only)
GEMINI_API_KEY=

# Optional local TLS pair. Leave both values empty for HTTP on 127.0.0.1.
# If TLS is enabled, both paths are required. Relative paths are resolved from
# the repository root.
APP_PEM=
APP_KEY=

# Local bind address and port
APP_HOST=127.0.0.1
APP_PORT=7860

# Public ICE/STUN/TURN configuration returned to the browser as JSON.
# Leave empty to use the demo's public STUN defaults.
# Example: {"iceServers":[{"urls":["stun:stun.l.google.com:19302"]}]}
RTC_CONFIGURATION=
