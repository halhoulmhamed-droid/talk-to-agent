# Copier ce fichier en `.env` à la racine du projet, puis renseigner les valeurs.
# Le fichier `.env` est ignoré par git — n'y mettez jamais de secret versionné.

# Clé API Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Certificat TLS auto-signé pour servir l'application en HTTPS
# (requis : getUserMedia / WebRTC n'est autorisé qu'en contexte sécurisé)
# Chemins relatifs à la racine du projet. Si absents, l'app démarre en HTTP.
APP_PEM=ssl/app.pem
APP_KEY=ssl/app.key

# Adresse et port d'écoute du serveur
APP_HOST=0.0.0.0
APP_PORT=7860

# Configuration ICE/STUN utilisée en local (JSON). Laisser vide pour utiliser
# la configuration par défaut définie dans src/static/script/script.js
RTC_CONFIGURATION=
